        "><div class="mb-4 flex items-start justify-between gap-3 shrink-0"><h2 id="modal-title" class="text-base font-semibold md:text-lg">Delete User</h2><div class="flex items-center gap-2"><button type="button" class="p-2 -mr-2 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors" title="Close" aria-label="Close modal"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></button></div></div><div class="flex-1 min-h-0 flex flex-col overflow-y-auto  text-sm md:text-base pr-1"><div class="space-y-4 text-center"><p class="text-gray-700">Are you sure you want to delete Acme?</p><div class="flex justify-center gap-3"><button type="button" class="
          rounded-xl font-bold transition-all
          inline-flex items-center justify-center gap-2.5
          bg-slate-100 text-slate-600 hover:bg-slate-200 border-2 border-slate-300
          px-4 py-2 text-sm
          
          
          
          focus:outline-none focus:ring-2 focus:ring-[#49293e]/30 focus:ring-offset-1
          
        "><span>Cancel</span></button><button type="button" class="
          rounded-xl font-bold transition-all
          inline-flex items-center justify-center gap-2.5
          bg-red-50 text-red-600 hover:bg-red-100 border-2 border-red-300
          px-4 py-2 text-sm
          
          
          
          focus:outline-none focus:ring-2 focus:ring-[#49293e]/30 focus:ring-offset-1
          
        "><span>Delete</span></button></div></div></div></div></div></div></div></div>"
`;

